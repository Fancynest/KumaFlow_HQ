<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_modern"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Balance"
            android:textColor="#B3FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_widget_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Rp 24.500.000"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-black"
            android:textSize="28sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_wallet_card_bg"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView android:id="@+id/tv_w1_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BCA" android:textColor="#B3FFFFFF" android:fontFamily="sans-serif-medium" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_w1_bal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Rp 12.000k" android:textColor="#FFFFFF" android:fontFamily="sans-serif-black" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_wallet_card_bg"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView android:id="@+id/tv_w2_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Blu" android:textColor="#B3FFFFFF" android:fontFamily="sans-serif-medium" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_w2_bal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Rp 8.500k" android:textColor="#FFFFFF" android:fontFamily="sans-serif-black" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_wallet_card_bg"
            android:orientation="vertical"
            android:padding="8dp">
            <TextView android:id="@+id/tv_w3_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gopay" android:textColor="#B3FFFFFF" android:fontFamily="sans-serif-medium" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/tv_w3_bal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Rp 4.000k" android:textColor="#FFFFFF" android:fontFamily="sans-serif-black" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲"
                android:textColor="#00E676"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_widget_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Rp 15.000.000"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="#FF1744"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_widget_expense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Rp 3.500.000"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- EXPANDED SECTION (Ditampilkan hanya saat widget di-resize vertikal >= 180dp) -->
    <LinearLayout
        android:id="@+id/layout_recent_transactions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent Transactions"
            android:textColor="#80FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/widget_tx_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tv_tx1_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/tv_tx1_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_tx_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tv_tx2_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/tv_tx2_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_tx_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tv_tx3_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/tv_tx3_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_tx_item_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tv_tx4_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/tv_tx4_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_widget_no_tx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada transaksi"
            android:textColor="#66FFFFFF"
            android:fontFamily="sans-serif"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>